{
  "version": "1.0.0",
  "features": {
    "auto_backup": true,
    "auto_update": false,
    "realtime_monitoring": true
  },
  "paths": {
    "backup_dir": "/home/user/.ransomwatch/backups",
    "log_dir": "/home/user/.ransomwatch/logs"
  },
  "thresholds": {
    "file_events_per_second": 15,
    "critical_cpu_usage": 85
  }
}

